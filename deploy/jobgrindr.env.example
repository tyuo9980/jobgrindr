# Copy to /home/ec2-user/jobgrindr-data/jobgrindr.env on the server.

# OAuth client of type "Web application", with https://api.t98.dev as an
# authorized JavaScript origin. Required in production: without it the server
# runs with no sign-in at all.
GOOGLE_CLIENT_ID=

# Comma-separated Google accounts allowed to sign in. Leave empty to let any
# Google account sign in (each sees only its own data).
ALLOWED_EMAILS=
